<?xml version="1.0" encoding="utf-8"?>
<log4net>
  <!--
    콘솔 출력 appender.
    형식: [yyyy-MM-dd HH:mm:ss.fff] [LEVEL] CategoryName.Method - message
  -->
  <appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date{yyyy-MM-dd HH:mm:ss.fff} [%-5level] %logger{1}.%method - %message%newline%exception" />
    </layout>
  </appender>

  <!--
    일반 로그 파일 appender (INFO 이상).
    5MB 기준 크기 롤링, 최대 10개 백업.
    백업 파일 패턴: App.1.log, App.2.log, ...
  -->
  <appender name="RollingFile" type="log4net.Appender.RollingFileAppender">
    <file value="Logs/App.log" />
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maximumFileSize value="5MB" />
    <maxSizeRollBackups value="10" />
    <preserveLogFileNameExtension value="true" />
    <staticLogFileName value="true" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date{yyyy-MM-dd HH:mm:ss.fff} [%-5level] %logger{1}.%method [line %line] - %message%newline%exception" />
    </layout>
    <filter type="log4net.Filter.LevelRangeFilter">
      <levelMin value="INFO" />
      <levelMax value="FATAL" />
    </filter>
  </appender>

  <!--
    에러 전용 파일 appender (ERROR 이상).
    5MB 기준 크기 롤링, 최대 10개 백업.
    백업 파일 패턴: Error.1.log, Error.2.log, ...
  -->
  <appender name="ErrorFile" type="log4net.Appender.RollingFileAppender">
    <file value="Logs/Error.log" />
    <appendToFile value="true" />
    <rollingStyle value="Size" />
    <maximumFileSize value="5MB" />
    <maxSizeRollBackups value="10" />
    <preserveLogFileNameExtension value="true" />
    <staticLogFileName value="true" />
    <layout type="log4net.Layout.PatternLayout">
      <conversionPattern value="%date{yyyy-MM-dd HH:mm:ss.fff} [%-5level] %logger{1}.%method [line %line] - %message%newline%exception" />
    </layout>
    <filter type="log4net.Filter.LevelRangeFilter">
      <levelMin value="ERROR" />
      <levelMax value="FATAL" />
    </filter>
  </appender>

  <root>
    <level value="INFO" />
    <appender-ref ref="RollingFile" />
    <appender-ref ref="ErrorFile" />
  </root>
</log4net>
